rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "owner";
    }

    // All collections: owner can read (for the dashboard), no client writes.
    // Every write happens server-side via Cloud Functions (Admin SDK bypasses rules).
    match /system/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /positions/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /trades/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /missedEntries/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /dailyStats/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /errors/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /tradeLogs/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
