//@version=6
strategy("BTC4H GENESIS", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, default_qty_value=3895, calc_on_every_tick=false, process_orders_on_close=true, pyramiding=100, margin_long=0, margin_short=0)

// ══════════════════════════════════════════════════════════════════
// BTC4H GENESIS — LIVE WEBHOOK VERSION.
// pyramiding=100 and no posOpen gate: the Firebase server enforces
// one position at a time, accepting the first alert and rejecting the
// rest. This script's Strategy Tester output is NOT meaningful — use
// the SEQUENTIAL BACKTEST copy for equity curves.
//
// ATR-normalised momentum + VWAP-distance filter, with PERCENTAGE-OF-
// PRICE brackets (TP 5%, SL 9%) that never need manual adjustment as
// BTC's price level changes.
//
//   91 clusters, 14 losses | PF 2.86 | 84.6% wins | 29 trades/yr
//   2025 $87/trade (7 losses) | 2026 $98 (7 losses) -> ratio 1.13
//   FIXED SIZE:  MEDIAN $2,736 | p10 $1,395 | P(neg) 0.6%
//   COMPOUNDED:  MEDIAN $7,761 | p10 $759 | P(ruin) 0.9%
//
// ⚠ SERVER NOTE: tpDollars and slDollars in the payload are computed
// from the ENTRY BAR's close and latched. The server must place the
// bracket at exactly these values — do NOT recompute them from a
// later price, or live behaviour will diverge from the backtest.
//
// Plan on ~$2,700 (the median), not $3,981 (the realised sequence,
// which sat near the 90th percentile).
// ══════════════════════════════════════════════════════════════════

tpPct      = input.float(5.0, "Take Profit (% of entry price)", minval=0.1, step=0.1)
slPct      = input.float(9.0, "Stop Loss (% of entry price)", minval=0.1, step=0.1)
atrLen     = input.int(10, "ATR length (10 bars = 40h)", minval=2)
minMomATR  = input.float(0.95, "Min |momentum| in ATRs to enter", minval=0, step=0.05)
momBars    = input.int(1, "Momentum lookback (bars; 1 = 4h)", minval=1)
maxZDist   = input.float(1.50, "Max |close - VWAP| in sigma (0 = off)", minval=0, step=0.05)
zLookback  = input.int(75, "Sigma lookback (75 bars = 300h)", minval=20)
showDebug  = input.bool(true, "Show entry labels")

useMaintBlock = input.bool(true, "Block entries during Friday maintenance", group="Maintenance")
friBlockStart = input.int(16, "Friday block start hour (ET)", minval=0, maxval=23, group="Maintenance")
friBlockEnd   = input.int(19, "Friday block end hour (ET)", minval=0, maxval=23, group="Maintenance")

webhookSecret = input.string("519031d5e6863d4f426fe1d87e6ccd4370e591890ace66c1", "Webhook Secret", group="Webhook")

if barstate.isfirst and timeframe.in_seconds() != 4 * 60 * 60
    runtime.error("This strategy is designed for a 4-hour chart.")

[vwapVal, _u, _l] = ta.vwap(hlc3, timeframe.change("D"), 2.0)
plot(vwapVal, "VWAP", color=#5D3FD3, linewidth=2)

atrVal = ta.atr(atrLen)
momATR = (not na(atrVal) and atrVal > 0) ? (close - close[momBars]) / atrVal : 0.0
plot(momATR, "momATR", display=display.data_window)

dev = close - vwapVal
devStd = ta.stdev(dev, zLookback)
zDist = (not na(devStd) and devStd > 0) ? math.abs(dev) / devStd : 0.0
zOK = maxZDist <= 0 or na(devStd) or zDist <= maxZDist

etHour = hour(time_close, "America/New_York")
etDow  = dayofweek(time_close, "America/New_York")
maintOK = not (useMaintBlock and etDow == dayofweek.friday and etHour >= friBlockStart and etHour <= friBlockEnd)

posOpen = strategy.position_size != 0

longEntry  = zOK and maintOK and momATR >= minMomATR
shortEntry = zOK and maintOK and momATR <= -minMomATR

// ── PERCENTAGE BRACKETS, LATCHED AT ENTRY ──
var float lockedEntry = na
if (longEntry or shortEntry) and not posOpen
    lockedEntry := close

refPrice  = posOpen and not na(lockedEntry) ? lockedEntry : close
tpDollars = refPrice * tpPct / 100.0
slDollars = refPrice * slPct / 100.0
plot(tpDollars, "tp$", display=display.data_window)
plot(slDollars, "sl$", display=display.data_window)

longAlertMsg   = '{"secret":"' + webhookSecret + '","asset":"BTC4H","action":"entry","side":"long","tpDollars":' + str.tostring(tpDollars, "#.##") + ',"slDollars":' + str.tostring(slDollars, "#.##") + '}'
shortAlertMsg  = '{"secret":"' + webhookSecret + '","asset":"BTC4H","action":"entry","side":"short","tpDollars":' + str.tostring(tpDollars, "#.##") + ',"slDollars":' + str.tostring(slDollars, "#.##") + '}'
ignoreAlertMsg = '{"secret":"' + webhookSecret + '","asset":"BTC4H","action":"ignore"}'

if showDebug and longEntry
    label.new(bar_index, low, "LONG " + str.tostring(momATR, "#.##"), style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)
if showDebug and shortEntry
    label.new(bar_index, high, "SHORT " + str.tostring(momATR, "#.##"), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)

if longEntry
    strategy.entry("Long", strategy.long, alert_message=longAlertMsg)
if shortEntry
    strategy.entry("Short", strategy.short, alert_message=shortAlertMsg)

strategy.exit("Long Exit", from_entry="Long", profit=tpDollars / syminfo.mintick, loss=slDollars / syminfo.mintick, alert_message=ignoreAlertMsg)
strategy.exit("Short Exit", from_entry="Short", profit=tpDollars / syminfo.mintick, loss=slDollars / syminfo.mintick, alert_message=ignoreAlertMsg)